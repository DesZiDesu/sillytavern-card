{"id":"54b38dd6-26da-4f49-ac20-957810316eee","scriptName":"HSR Dialogue C — Data Bank","findRegex":"/\\[HSRSAY\\|([^|\\]]*)\\|([^|\\]]+)\\|([\\s\\S]*?)\\]/g","replaceString":"<link href=\"https://fonts.googleapis.com/css2?family=Marcellus&family=Chakra+Petch:wght@500;600;700&family=Bai+Jamjuree:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap\" rel=\"stylesheet\"/><style>\n.hsr-el-physical{--c:#dfe1ea}.hsr-el-fire{--c:#ff8f6b}.hsr-el-ice{--c:#74d2ff}.hsr-el-lightning{--c:#c58bff}.hsr-el-wind{--c:#7fe6ab}.hsr-el-quantum{--c:#8f9bff}.hsr-el-imaginary{--c:#ffd76b}\n\n.hsr-dc{box-sizing:border-box;position:relative;width:100%;max-width:860px;margin:8px auto;padding:12px 15px;color:#2a303a;background:linear-gradient(180deg,#f2f4f7,#dce1e7);border:1px solid #c4cbd5;font-family:'Bai Jamjuree','Chakra Petch',sans-serif}\n.hsr-dc-head{display:flex;align-items:center;gap:7px;color:#7f6a3f;font:700 8px/1 'Chakra Petch',sans-serif;letter-spacing:.16em;text-transform:uppercase}\n.hsr-dc-head:after{content:'';flex:1;height:1px;background:linear-gradient(90deg,#b49b5f,var(--c),transparent)}\n.hsr-dc-body{margin-top:7px;color:#303641;font:500 clamp(13px,3.5vw,14px)/1.56 'Bai Jamjuree','Chakra Petch',sans-serif;overflow-wrap:anywhere}\n</style><div class=\"hsr-el-$2 hsr-dc\"><div class=\"hsr-dc-head\">$1</div><div class=\"hsr-dc-body\">$3</div></div>","trimStrings":[],"placement":[1,2],"disabled":false,"markdownOnly":true,"promptOnly":false,"runOnEdit":true,"substituteRegex":0,"minDepth":null,"maxDepth":null}