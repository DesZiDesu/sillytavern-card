{
  "id": "f4619a54-980e-40fc-a5e0-f777e81a99bd",
  "scriptName": "HSR Status Tracker — Collapsible Astral HUD",
  "findRegex": "/<hsr_status>\\s*\\{\\s*\"schema\"\\s*:\\s*\"hsr_status\\.v1\"\\s*,\\s*\"character\"\\s*:\\s*\"([^\"]*)\"\\s*,\\s*\"hp\"\\s*:\\s*\\{\\s*\"current\"\\s*:\\s*(\\d+(?:\\.\\d+)?)\\s*,\\s*\"max\"\\s*:\\s*(\\d+(?:\\.\\d+)?)\\s*\\}\\s*,\\s*\"element\"\\s*:\\s*\"(physical|fire|ice|lightning|wind|quantum|imaginary)\"\\s*,\\s*\"path\"\\s*:\\s*\"(destruction|hunt|erudition|harmony|nihility|preservation|abundance|remembrance|elation|propagation|trailblaze)\"\\s*,\\s*\"bond\"\\s*:\\s*\\{\\s*\"current\"\\s*:\\s*(\\d+(?:\\.\\d+)?)\\s*,\\s*\"max\"\\s*:\\s*(\\d+(?:\\.\\d+)?)\\s*\\}\\s*,\\s*\"items\"\\s*:\\s*\\[\\s*(?:null|\"([^\"]*)\")\\s*,\\s*(?:null|\"([^\"]*)\")\\s*,\\s*(?:null|\"([^\"]*)\")\\s*,\\s*(?:null|\"([^\"]*)\")\\s*\\]\\s*\\}\\s*<\\/hsr_status>/gi",
  "replaceString": "<link href=\"https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=Bai+Jamjuree:wght@400;500;600;700&family=Share+Tech+Mono&display=swap\" rel=\"stylesheet\"/><style>.hsr-st{--el:#e7c98b;position:relative;width:100%;max-width:900px;margin:18px auto 0;color:#eef2fb;font-family:'Bai Jamjuree','Chakra Petch',sans-serif;background:linear-gradient(145deg,rgba(15,21,35,.99),rgba(6,9,18,.99));border:1px solid rgba(231,201,139,.55);border-radius:7px;box-shadow:0 13px 32px rgba(0,0,0,.34),inset 0 0 34px rgba(95,145,255,.05);overflow:hidden}.hsr-st,.hsr-st *{box-sizing:border-box;min-width:0;max-width:100%}.hsr-st:before{content:'';position:absolute;inset:0;pointer-events:none;opacity:.32;background-image:linear-gradient(115deg,transparent 0 47%,rgba(255,255,255,.025) 47% 48%,transparent 48% 100%),radial-gradient(circle,rgba(255,255,255,.7) 0 1px,transparent 1.5px);background-size:31px 31px,83px 83px}.hsr-st summary{position:relative;display:flex;align-items:center;min-height:54px;padding:10px 15px;gap:11px;cursor:pointer;list-style:none;background:linear-gradient(90deg,color-mix(in srgb,var(--el) 14%,#101726),rgba(9,13,24,.96) 58%,color-mix(in srgb,var(--el) 8%,#0b101c));user-select:none}.hsr-st summary::-webkit-details-marker{display:none}.hsr-st[open] summary{border-bottom:1px solid rgba(231,201,139,.22)}.hsr-st-emblem{position:relative;display:grid;place-items:center;width:28px;height:28px;flex:0 0 28px;border:1px solid var(--el);transform:rotate(45deg);box-shadow:0 0 14px color-mix(in srgb,var(--el) 35%,transparent),inset 0 0 8px color-mix(in srgb,var(--el) 18%,transparent)}.hsr-st-emblem:before,.hsr-st-emblem:after{content:'';position:absolute;background:var(--el)}.hsr-st-emblem:before{width:11px;height:1px}.hsr-st-emblem:after{width:1px;height:11px}.hsr-st-title{flex:1;min-width:0;font:700 11px/1.35 'Chakra Petch','Bai Jamjuree',sans-serif;letter-spacing:.16em;color:#f4efe4;text-transform:uppercase;white-space:normal;overflow-wrap:anywhere;word-break:break-word}.hsr-st-chevron{position:relative;width:25px;height:25px;margin-left:auto;flex:0 0 25px;border:1px solid rgba(231,201,139,.42);border-radius:50%;transition:transform .24s ease,background .24s ease}.hsr-st-chevron:before{content:'';position:absolute;left:8px;top:7px;width:6px;height:6px;border-right:2px solid var(--el);border-bottom:2px solid var(--el);transform:rotate(45deg)}.hsr-st[open] .hsr-st-chevron{transform:rotate(180deg);background:color-mix(in srgb,var(--el) 10%,transparent)}.hsr-st-body{position:relative;padding:14px;background:radial-gradient(circle at 12% 0,color-mix(in srgb,var(--el) 9%,transparent),transparent 34%)}.hsr-st-identity{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:10px;margin-bottom:12px}.hsr-st-idcard{display:flex;align-items:center;gap:10px;padding:9px 11px;background:rgba(255,255,255,.025);border:1px solid rgba(255,255,255,.075);clip-path:polygon(8px 0,100% 0,100% calc(100% - 8px),calc(100% - 8px) 100%,0 100%,0 8px)}.hsr-st-icon{display:grid;place-items:center;width:37px;height:37px;flex:0 0 37px;border:1px solid color-mix(in srgb,var(--el) 62%,#fff);border-radius:50%;color:var(--el);background:radial-gradient(circle,color-mix(in srgb,var(--el) 18%,transparent),transparent 67%);box-shadow:0 0 15px color-mix(in srgb,var(--el) 18%,transparent)}.hsr-st-icon svg{width:24px;height:24px;filter:drop-shadow(0 0 4px color-mix(in srgb,var(--el) 45%,transparent))}.hsr-el-icon,.hsr-path-icon{display:none}.hsr-el-physical .hsr-e-physical,.hsr-el-fire .hsr-e-fire,.hsr-el-ice .hsr-e-ice,.hsr-el-lightning .hsr-e-lightning,.hsr-el-wind .hsr-e-wind,.hsr-el-quantum .hsr-e-quantum,.hsr-el-imaginary .hsr-e-imaginary,.hsr-path-destruction .hsr-p-destruction,.hsr-path-hunt .hsr-p-hunt,.hsr-path-erudition .hsr-p-erudition,.hsr-path-harmony .hsr-p-harmony,.hsr-path-nihility .hsr-p-nihility,.hsr-path-preservation .hsr-p-preservation,.hsr-path-abundance .hsr-p-abundance,.hsr-path-remembrance .hsr-p-remembrance,.hsr-path-elation .hsr-p-elation,.hsr-path-propagation .hsr-p-propagation,.hsr-path-trailblaze .hsr-p-trailblaze{display:block}.hsr-el-physical{--el:#e2e5ec}.hsr-el-fire{--el:#ff795f}.hsr-el-ice{--el:#65cfff}.hsr-el-lightning{--el:#bd83ff}.hsr-el-wind{--el:#69e0ad}.hsr-el-quantum{--el:#7e8dff}.hsr-el-imaginary{--el:#ffd35f}.hsr-st-meta{min-width:0}.hsr-st-k{font:600 8px/1.25 'Chakra Petch';letter-spacing:.2em;color:#7888a4;text-transform:uppercase;white-space:normal;overflow-wrap:anywhere}.hsr-st-v{margin-top:4px;font:700 12px/1.35 'Chakra Petch','Bai Jamjuree';color:#f0eadc;text-transform:capitalize;white-space:normal;overflow-wrap:anywhere;word-break:break-word}.hsr-st-meters{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:10px;margin-bottom:12px}.hsr-meter{padding:10px 11px;background:linear-gradient(105deg,rgba(255,255,255,.035),rgba(255,255,255,.012));border-left:2px solid var(--meter,#ff6f73);border-top:1px solid rgba(255,255,255,.055);border-bottom:1px solid rgba(255,255,255,.045)}.hsr-meter-head{display:flex;align-items:flex-start;justify-content:space-between;gap:8px;flex-wrap:wrap;margin-bottom:7px}.hsr-meter-name{font:700 9px/1.25 'Chakra Petch';letter-spacing:.18em;color:#a7b2c6;white-space:normal;overflow-wrap:anywhere}.hsr-meter-num{font:600 10px/1.25 'Share Tech Mono';color:#f3f5f9;white-space:normal;overflow-wrap:anywhere;text-align:right}.hsr-meter progress{display:block;width:100%;height:7px;appearance:none;-webkit-appearance:none;border:0;border-radius:0;background:#252c3b;overflow:hidden}.hsr-meter progress::-webkit-progress-bar{background:#252c3b}.hsr-meter progress::-webkit-progress-value{background:linear-gradient(90deg,color-mix(in srgb,var(--meter) 72%,#fff),var(--meter));box-shadow:0 0 9px color-mix(in srgb,var(--meter) 45%,transparent)}.hsr-meter progress::-moz-progress-bar{background:linear-gradient(90deg,color-mix(in srgb,var(--meter) 72%,#fff),var(--meter));box-shadow:0 0 9px color-mix(in srgb,var(--meter) 45%,transparent)}.hsr-meter-bond{--meter:#e8bd74}.hsr-items-head{display:flex;align-items:flex-start;gap:8px;margin-bottom:8px;font:700 9px/1.35 'Chakra Petch';letter-spacing:.18em;color:#9ba8bd;text-transform:uppercase;white-space:normal;overflow-wrap:anywhere}.hsr-items-head:before{content:'◆';font-size:7px;color:var(--el);flex:0 0 auto}.hsr-items{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.hsr-item{position:relative;min-height:51px;padding:8px 8px 7px 36px;display:flex;align-items:center;background:linear-gradient(140deg,rgba(255,255,255,.04),rgba(255,255,255,.012));border:1px solid rgba(231,201,139,.17);clip-path:polygon(7px 0,100% 0,100% calc(100% - 7px),calc(100% - 7px) 100%,0 100%,0 7px);overflow:hidden}.hsr-item:before{content:attr(data-slot);position:absolute;left:8px;top:9px;display:grid;place-items:center;width:19px;height:19px;border:1px solid color-mix(in srgb,var(--el) 55%,transparent);font:700 8px/1 'Share Tech Mono';color:var(--el);transform:rotate(45deg)}.hsr-item-name{font-size:10px;line-height:1.35;color:#dce2ee;white-space:normal;overflow-wrap:anywhere;word-break:break-word}.hsr-item-name:empty:after{content:'EMPTY';color:#59667c;font:600 8px/1.25 'Chakra Petch';letter-spacing:.12em}.hsr-st-paths{display:none}@media(max-width:620px){.hsr-st-body{padding:11px}.hsr-st-identity,.hsr-st-meters{grid-template-columns:1fr}.hsr-items{grid-template-columns:1fr}.hsr-st-title{font-size:10px;letter-spacing:.11em}.hsr-st-idcard,.hsr-meter,.hsr-item{width:100%}}@media(prefers-reduced-motion:reduce){.hsr-st-chevron{transition:none}}</style><details class=\"hsr-st hsr-el-$4 hsr-path-$5\"><summary><span class=\"hsr-st-emblem\"></span><span class=\"hsr-st-title\">CHARACTER STATUS · $1</span><span class=\"hsr-st-chevron\"></span></summary><div class=\"hsr-st-body\"><div class=\"hsr-st-identity\"><div class=\"hsr-st-idcard\"><span class=\"hsr-st-icon\"><svg class=\"hsr-el-icon hsr-e-physical\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 1.8l2.4 6.5L21 11l-6.6 2.5L12 20.2l-2.4-6.7L3 11l6.6-2.7z\"/></svg><svg class=\"hsr-el-icon hsr-e-fire\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2c3 3.8 5.2 6 5.2 9.4a5.2 5.2 0 11-10.4 0c0-1.5.7-2.8 2-4C9.4 9.6 12 9.4 12 2z\"/></svg><svg class=\"hsr-el-icon hsr-e-ice\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><path d=\"M12 2v20M3.5 7l17 10M20.5 7l-17 10M12 6l2-2m-2 2-2-2m2 14 2 2m-2-2-2 2\"/></svg><svg class=\"hsr-el-icon hsr-e-lightning\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M13.5 1.5L4.8 13h5.5L9 22.5 19.2 9.2H13z\"/></svg><svg class=\"hsr-el-icon hsr-e-wind\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><path d=\"M3 8h11a3 3 0 10-3-3M3 13h9a3 3 0 11-3 3M3 18h5\"/></svg><svg class=\"hsr-el-icon hsr-e-quantum\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><ellipse cx=\"12\" cy=\"12\" rx=\"9\" ry=\"3.5\"/><ellipse cx=\"12\" cy=\"12\" rx=\"9\" ry=\"3.5\" transform=\"rotate(60 12 12)\"/><ellipse cx=\"12\" cy=\"12\" rx=\"9\" ry=\"3.5\" transform=\"rotate(120 12 12)\"/><circle cx=\"12\" cy=\"12\" r=\"1.7\" fill=\"currentColor\"/></svg><svg class=\"hsr-el-icon hsr-e-imaginary\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><circle cx=\"12\" cy=\"12\" r=\"4.5\"/><circle cx=\"12\" cy=\"12\" r=\"1.4\" fill=\"currentColor\"/></svg></span><span class=\"hsr-st-meta\"><span class=\"hsr-st-k\">Combat Type</span><span class=\"hsr-st-v\">$4</span></span></div><div class=\"hsr-st-idcard\"><span class=\"hsr-st-icon\"><svg class=\"hsr-path-icon hsr-p-destruction\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><path d=\"M12 2l2.2 6.2L21 10l-5 4 1.6 7-5.6-3.5L6.4 21 8 14l-5-4 6.8-1.8z\"/><path d=\"M7 6l10 12\"/></svg><svg class=\"hsr-path-icon hsr-p-hunt\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M4 20L19 5m-7-1h8v8M5 8l5 1-1 5\"/></svg><svg class=\"hsr-path-icon hsr-p-erudition\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M3 12s3.5-6 9-6 9 6 9 6-3.5 6-9 6-9-6-9-6z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M12 2v2m0 16v2\"/></svg><svg class=\"hsr-path-icon hsr-p-harmony\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><circle cx=\"8\" cy=\"12\" r=\"5\"/><circle cx=\"16\" cy=\"12\" r=\"5\"/><circle cx=\"12\" cy=\"8\" r=\"5\"/></svg><svg class=\"hsr-path-icon hsr-p-nihility\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><path d=\"M20 12a8 8 0 11-8-8c4 0 6 3 6 6 0 4-3 6-6 6-2.5 0-4-1.5-4-3.5 0-1.5 1-2.5 2.5-2.5 1 0 1.8.8 1.8 1.8\"/></svg><svg class=\"hsr-path-icon hsr-p-preservation\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><path d=\"M12 2l8 3v6c0 5-3.2 8.5-8 11-4.8-2.5-8-6-8-11V5z\"/><path d=\"M8 12l2.5 2.5L16.5 8\"/></svg><svg class=\"hsr-path-icon hsr-p-abundance\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M12 21V9m0 4c-4-1-6-3-7-7 4 0 6 1 7 4m0 6c4-1 6-3 7-7-4 0-6 1-7 4M8 21h8\"/></svg><svg class=\"hsr-path-icon hsr-p-remembrance\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M12 2l7 5v10l-7 5-7-5V7z\"/><path d=\"M12 6v12M7 9l10 6m0-6L7 15\"/></svg><svg class=\"hsr-path-icon hsr-p-elation\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M4 5c4-2 12-2 16 0l-2 11c-3 4-9 4-12 0z\"/><path d=\"M8 10l2 1m6-1-2 1m-5 3c2 2 4 2 6 0\"/></svg><svg class=\"hsr-path-icon hsr-p-propagation\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M12 7v14M8 10c-5-5-7 0-4 4 2 3 5 3 8 1m4-5c5-5 7 0 4 4-2 3-5 3-8 1M9 6l3-4 3 4\"/></svg><svg class=\"hsr-path-icon hsr-p-trailblaze\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M15.5 8.5l-2 5-5 2 2-5z\"/><path d=\"M12 1v3m0 16v3M1 12h3m16 0h3\"/></svg></span><span class=\"hsr-st-meta\"><span class=\"hsr-st-k\">Path</span><span class=\"hsr-st-v\">$5</span></span></div></div><div class=\"hsr-st-meters\"><div class=\"hsr-meter\"><div class=\"hsr-meter-head\"><span class=\"hsr-meter-name\">HP</span><span class=\"hsr-meter-num\">$2 / $3</span></div><progress value=\"$2\" max=\"$3\"></progress></div><div class=\"hsr-meter hsr-meter-bond\"><div class=\"hsr-meter-head\"><span class=\"hsr-meter-name\">BOND</span><span class=\"hsr-meter-num\">$6 / $7</span></div><progress value=\"$6\" max=\"$7\"></progress></div></div><div class=\"hsr-items-head\">Inventory · 4 Slots</div><div class=\"hsr-items\"><div class=\"hsr-item\" data-slot=\"01\"><span class=\"hsr-item-name\">$8</span></div><div class=\"hsr-item\" data-slot=\"02\"><span class=\"hsr-item-name\">$9</span></div><div class=\"hsr-item\" data-slot=\"03\"><span class=\"hsr-item-name\">$10</span></div><div class=\"hsr-item\" data-slot=\"04\"><span class=\"hsr-item-name\">$11</span></div></div></div></details>",
