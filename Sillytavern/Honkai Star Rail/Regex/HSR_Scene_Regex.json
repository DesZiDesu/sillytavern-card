{
  "id": "ba706469-6c90-48fc-9ed4-5a54a617c4cf",
  "scriptName": "HSR Scene Tracker — Golden Archive",
  "findRegex": "/<hsr_scene>\\s*\\{\\s*\"schema\"\\s*:\\s*\"hsr_scene\\.v1\"\\s*,\\s*\"time\"\\s*:\\s*\"([^\"]*)\"\\s*,\\s*\"period\"\\s*:\\s*\"(dawn|day|dusk|night)\"\\s*,\\s*\"weather\"\\s*:\\s*\"([^\"]*)\"\\s*,\\s*\"temperature_c\"\\s*:\\s*(-?\\d+(?:\\.\\d+)?)\\s*,\\s*\"location\"\\s*:\\s*\"([^\"]*)\"\\s*,\\s*\"zone\"\\s*:\\s*\"([^\"]*)\"\\s*,\\s*\"situation\"\\s*:\\s*\"([^\"]*)\"\\s*\\}\\s*<\\/hsr_scene>/gi",
  "replaceString": "<style>.hsr-scene{--g:#d7b76a;--ink:#171512;position:relative;max-width:920px;margin:0 auto 18px;padding:18px;color:#201d18;font-family:Georgia,'Times New Roman',serif;background:linear-gradient(118deg,rgba(37,34,29,.96) 0 41%,rgba(245,239,222,.98) 41% 100%);border:1px solid rgba(215,183,106,.72);box-shadow:0 18px 42px rgba(0,0,0,.36);overflow:hidden}.hsr-scene:before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 24% 22%,rgba(255,218,126,.14),transparent 30%),linear-gradient(130deg,transparent 0 39%,rgba(215,183,106,.48) 39% 40%,transparent 40%);pointer-events:none}.hsr-scene-grid{position:relative;display:grid;grid-template-columns:minmax(220px,.85fr) 1.6fr;min-height:190px}.hsr-scene-visual{position:relative;padding:18px 22px;border-right:1px solid rgba(215,183,106,.45);background:linear-gradient(180deg,rgba(255,255,255,.04),transparent)}.hsr-scene-sigil{width:86px;height:86px;margin-bottom:22px;border:1px solid var(--g);border-radius:50%;box-shadow:0 0 22px rgba(215,183,106,.22),inset 0 0 22px rgba(215,183,106,.12);position:relative}.hsr-scene-sigil:before,.hsr-scene-sigil:after{content:'';position:absolute;inset:18px;border:1px solid var(--g);transform:rotate(45deg)}.hsr-scene-sigil:after{inset:36px;background:var(--g)}.hsr-scene-time{font-size:34px;letter-spacing:.08em;color:#f4e7c3}.hsr-scene-period{margin-top:5px;font:600 10px/1 Arial,sans-serif;letter-spacing:.24em;text-transform:uppercase;color:var(--g)}.hsr-scene-main{position:relative;padding:12px 18px 10px 28px}.hsr-scene-kicker{font:700 10px/1 Arial,sans-serif;letter-spacing:.22em;text-transform:uppercase;color:#7f6b3a}.hsr-scene-location{margin:10px 0 3px;font-size:32px;line-height:1;color:#191713}.hsr-scene-zone{font:600 11px/1.3 Arial,sans-serif;letter-spacing:.12em;color:#6e6658;text-transform:uppercase}.hsr-scene-rule{height:1px;margin:18px 0;background:linear-gradient(90deg,var(--g),transparent)}.hsr-scene-meta{display:grid;grid-template-columns:1fr 1fr;gap:12px}.hsr-scene-card{padding:11px 12px;border:1px solid rgba(79,67,42,.25);background:rgba(255,255,255,.38)}.hsr-scene-label{font:700 9px/1 Arial,sans-serif;letter-spacing:.18em;text-transform:uppercase;color:#8b7340}.hsr-scene-value{margin-top:7px;font:700 15px/1.25 Arial,sans-serif;color:#2a2722}.hsr-scene-situation{grid-column:1/-1;padding-top:12px;border-top:1px solid rgba(79,67,42,.18);font-size:15px;line-height:1.45;color:#353129}@media(max-width:650px){.hsr-scene{padding:10px;background:linear-gradient(160deg,rgba(37,34,29,.98) 0 34%,rgba(245,239,222,.98) 34% 100%)}.hsr-scene-grid{grid-template-columns:1fr}.hsr-scene-visual{min-height:135px;border-right:0;border-bottom:1px solid rgba(215,183,106,.45)}.hsr-scene-sigil{width:62px;height:62px;margin-bottom:12px}.hsr-scene-location{font-size:26px}.hsr-scene-main{padding:20px 10px 8px}.hsr-scene-meta{grid-template-columns:1fr}}</style><section class=\"hsr-scene\"><div class=\"hsr-scene-grid\"><div class=\"hsr-scene-visual\"><div class=\"hsr-scene-sigil\"></div><div class=\"hsr-scene-time\">$1</div><div class=\"hsr-scene-period\">$2 · Local Time</div></div><div class=\"hsr-scene-main\"><div class=\"hsr-scene-kicker\">Astral Archive · Current Scene</div><div class=\"hsr-scene-location\">$5</div><div class=\"hsr-scene-zone\">$6</div><div class=\"hsr-scene-rule\"></div><div class=\"hsr-scene-meta\"><div class=\"hsr-scene-card\"><div class=\"hsr-scene-label\">Weather</div><div class=\"hsr-scene-value\">$3</div></div><div class=\"hsr-scene-card\"><div class=\"hsr-scene-label\">Temperature</div><div class=\"hsr-scene-value\">$4°C</div></div><div class=\"hsr-scene-situation\"><div class=\"hsr-scene-label\">Situation</div><div class=\"hsr-scene-value\">$7</div></div></div></div></div></section>",
  "trimStrings": [],
  "placement": [1,2],
  "disabled": false,
  "markdownOnly": true,
  "promptOnly": false,
  "runOnEdit": true,
  "substituteRegex": 0,
  "minDepth": null,
  "maxDepth": 2
}
