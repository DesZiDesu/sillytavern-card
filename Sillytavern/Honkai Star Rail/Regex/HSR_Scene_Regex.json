{
  "id": "ba706469-6c90-48fc-9ed4-5a54a617c4cf",
  "scriptName": "HSR Scene Tracker — Desolation Chronicle",
  "findRegex": "/<hsr_scene>\\s*\\{\\s*\"schema\"\\s*:\\s*\"hsr_scene\\.v1\"\\s*,\\s*\"time\"\\s*:\\s*\"([^\"]*)\"\\s*,\\s*\"period\"\\s*:\\s*\"(dawn|day|dusk|night)\"\\s*,\\s*\"weather\"\\s*:\\s*\"([^\"]*)\"\\s*,\\s*\"temperature_c\"\\s*:\\s*(-?\\d+(?:\\.\\d+)?)\\s*,\\s*\"location\"\\s*:\\s*\"([^\"]*)\"\\s*,\\s*\"zone\"\\s*:\\s*\"([^\"]*)\"\\s*,\\s*\"situation\"\\s*:\\s*\"([^\"]*)\"\\s*\\}\\s*<\\/hsr_scene>/gi",
  "replaceString": "<style>.hsr-scene{--g:#c7ad70;max-width:920px;margin:0 auto 12px;position:relative;overflow:hidden;background:radial-gradient(circle at 84% 12%,rgba(255,255,255,.06),transparent 28%),linear-gradient(180deg,#252932,#14171d 78%);border:1px solid rgba(199,173,112,.6);box-shadow:0 12px 30px #0008;color:#ece9e2;font-family:Georgia,'Times New Roman',serif}.hsr-scene:before{content:'';position:absolute;inset:0;background:linear-gradient(115deg,transparent 0 55%,rgba(255,255,255,.025) 55% 56%,transparent 56%),radial-gradient(circle,rgba(255,255,255,.55) 0 1px,transparent 1.3px);background-size:auto,68px 68px;opacity:.35;pointer-events:none}.hsr-corner{position:absolute;width:16px;height:16px;border-color:var(--g);z-index:2}.hsr-c1{left:6px;top:6px;border-left:1px solid;border-top:1px solid}.hsr-c2{right:6px;top:6px;border-right:1px solid;border-top:1px solid}.hsr-c3{left:6px;bottom:6px;border-left:1px solid;border-bottom:1px solid}.hsr-c4{right:6px;bottom:6px;border-right:1px solid;border-bottom:1px solid}.hsr-bar{position:relative;display:grid;grid-template-columns:110px minmax(210px,1.4fr) 100px 82px;align-items:stretch;border-bottom:1px solid rgba(199,173,112,.22)}.hsr-cell{min-width:0;padding:10px 12px;border-left:1px solid rgba(199,173,112,.17);display:flex;flex-direction:column;justify-content:center}.hsr-cell:first-child{border-left:0}.hsr-label{font:700 8px/1 Arial,sans-serif;letter-spacing:.17em;text-transform:uppercase;color:#ad9869}.hsr-time{margin-top:4px;font:700 25px/1 Georgia,serif;color:#f0eadf}.hsr-value{margin-top:5px;font:600 12px/1.3 Arial,sans-serif;color:#e8e5de;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.hsr-location{font:600 16px/1.2 Georgia,serif}.hsr-zone{margin-top:3px;font:600 9px/1.2 Arial,sans-serif;letter-spacing:.08em;color:#999;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.hsr-rule{position:relative;height:1px;background:linear-gradient(90deg,transparent,var(--g),transparent);opacity:.6}.hsr-note{position:relative;display:grid;grid-template-columns:86px 1fr;gap:12px;padding:10px 12px 11px}.hsr-kicker{font:700 8px/1.25 Arial,sans-serif;letter-spacing:.17em;text-transform:uppercase;color:#ad9869}.hsr-text{font:italic 13px/1.45 Georgia,'Times New Roman',serif;color:#ebe5da}@media(max-width:620px){.hsr-scene{overflow-x:auto}.hsr-bar,.hsr-note{min-width:620px}.hsr-bar{grid-template-columns:100px 250px 100px 80px}.hsr-note{grid-template-columns:82px 1fr}.hsr-cell{padding:9px 10px}.hsr-time{font-size:22px}}</style><section class=\"hsr-scene\"><span class=\"hsr-corner hsr-c1\"></span><span class=\"hsr-corner hsr-c2\"></span><span class=\"hsr-corner hsr-c3\"></span><span class=\"hsr-corner hsr-c4\"></span><div class=\"hsr-bar\"><div class=\"hsr-cell\"><div class=\"hsr-label\">Time · $2</div><div class=\"hsr-time\">$1</div></div><div class=\"hsr-cell\"><div class=\"hsr-label\">Location</div><div class=\"hsr-value hsr-location\">$5</div><div class=\"hsr-zone\">$6</div></div><div class=\"hsr-cell\"><div class=\"hsr-label\">Weather</div><div class=\"hsr-value\">$3</div></div><div class=\"hsr-cell\"><div class=\"hsr-label\">Temp</div><div class=\"hsr-value\">$4°C</div></div></div><div class=\"hsr-rule\"></div><div class=\"hsr-note\"><div class=\"hsr-kicker\">Scene Chronicle</div><div class=\"hsr-text\">$7</div></div></section>",
  "trimStrings": [],
  "placement": [1,2],
  "disabled": false,
  "markdownOnly": true,
  "promptOnly": false,
  "runOnEdit": true,
  "substituteRegex": 0,
  "minDepth": null,
  "maxDepth": 2
}
