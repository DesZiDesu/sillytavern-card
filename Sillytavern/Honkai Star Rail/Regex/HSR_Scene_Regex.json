{
  "id": "ba706469-6c90-48fc-9ed4-5a54a617c4cf",
  "scriptName": "HSR Scene Tracker — Golden Archive Horizontal",
  "findRegex": "/<hsr_scene>\\s*\\{\\s*\"schema\"\\s*:\\s*\"hsr_scene\\.v1\"\\s*,\\s*\"time\"\\s*:\\s*\"([^\"]*)\"\\s*,\\s*\"period\"\\s*:\\s*\"(dawn|day|dusk|night)\"\\s*,\\s*\"weather\"\\s*:\\s*\"([^\"]*)\"\\s*,\\s*\"temperature_c\"\\s*:\\s*(-?\\d+(?:\\.\\d+)?)\\s*,\\s*\"location\"\\s*:\\s*\"([^\"]*)\"\\s*,\\s*\"zone\"\\s*:\\s*\"([^\"]*)\"\\s*,\\s*\"situation\"\\s*:\\s*\"([^\"]*)\"\\s*\\}\\s*<\\/hsr_scene>/gi",
  "replaceString": "<style>.hsr-scene{--g:#d8b96c;max-width:920px;margin:0 auto 12px;background:linear-gradient(112deg,#25221d 0 24%,#f2ecdc 24% 100%);border:1px solid #b89a55;box-shadow:0 8px 22px #0006;overflow:hidden;font-family:Georgia,serif}.hsr-row{display:grid;grid-template-columns:145px minmax(210px,1.4fr) 110px 90px minmax(210px,1.5fr);min-height:76px}.hsr-cell{min-width:0;padding:11px 12px;display:flex;flex-direction:column;justify-content:center;border-left:1px solid #6f603028}.hsr-cell:first-child{border-left:0;color:#f4e6c0;padding-left:17px}.hsr-time{font-size:27px;line-height:1;letter-spacing:.06em}.hsr-period,.hsr-label{font:700 8px/1 Arial,sans-serif;letter-spacing:.17em;text-transform:uppercase}.hsr-period{margin-top:5px;color:var(--g)}.hsr-label{color:#876f38}.hsr-value{margin-top:6px;font:700 13px/1.25 Arial,sans-serif;color:#27231d;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.hsr-location{font:700 19px/1.1 Georgia,serif}.hsr-zone{margin-top:3px;font:600 9px/1.2 Arial,sans-serif;color:#746b5c;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.hsr-situation .hsr-value{white-space:normal;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}@media(max-width:560px){.hsr-scene{overflow-x:auto}.hsr-row{min-width:680px;min-height:70px}.hsr-cell{padding:9px}.hsr-time{font-size:22px}.hsr-location{font-size:16px}}</style><section class=\"hsr-scene\"><div class=\"hsr-row\"><div class=\"hsr-cell\"><div class=\"hsr-time\">$1</div><div class=\"hsr-period\">$2 · Local</div></div><div class=\"hsr-cell\"><div class=\"hsr-label\">Current Location</div><div class=\"hsr-value hsr-location\">$5</div><div class=\"hsr-zone\">$6</div></div><div class=\"hsr-cell\"><div class=\"hsr-label\">Weather</div><div class=\"hsr-value\">$3</div></div><div class=\"hsr-cell\"><div class=\"hsr-label\">Temp</div><div class=\"hsr-value\">$4°C</div></div><div class=\"hsr-cell hsr-situation\"><div class=\"hsr-label\">Situation</div><div class=\"hsr-value\">$7</div></div></div></section>",
  "trimStrings": [],
  "placement": [1,2],
  "disabled": false,
  "markdownOnly": true,
  "promptOnly": false,
  "runOnEdit": true,
  "substituteRegex": 0,
  "minDepth": null,
  "maxDepth": 2
}
