{
  "id": "ba706469-6c90-48fc-9ed4-5a54a617c4cf",
  "scriptName": "HSR Scene Tracker — Desolation Chronicle Content Safe",
  "findRegex": "/<hsr_scene>\\s*\\{\\s*\"schema\"\\s*:\\s*\"hsr_scene\\.v1\"\\s*,\\s*\"time\"\\s*:\\s*\"([^\"]*)\"\\s*,\\s*\"period\"\\s*:\\s*\"(dawn|day|dusk|night)\"\\s*,\\s*\"weather\"\\s*:\\s*\"([^\"]*)\"\\s*,\\s*\"temperature_c\"\\s*:\\s*(-?\\d+(?:\\.\\d+)?)\\s*,\\s*\"location\"\\s*:\\s*\"([^\"]*)\"\\s*,\\s*\"zone\"\\s*:\\s*\"([^\"]*)\"\\s*,\\s*\"situation\"\\s*:\\s*\"([^\"]*)\"\\s*\\}\\s*<\\/hsr_scene>/gi",
  "replaceString": "<style>\n.hsr-scene{--g:#c7ad70;max-width:920px;margin:0 auto 12px;position:relative;overflow:hidden;background:radial-gradient(circle at 84% 12%,rgba(255,255,255,.06),transparent 28%),linear-gradient(180deg,#252932,#14171d 78%);border:1px solid rgba(199,173,112,.6);box-shadow:0 12px 30px #0008;color:#ece9e2;font-family:Georgia,'Times New Roman',serif}\n.hsr-scene:before{content:'';position:absolute;inset:0;background:linear-gradient(115deg,transparent 0 55%,rgba(255,255,255,.025) 55% 56%,transparent 56%),radial-gradient(circle,rgba(255,255,255,.55) 0 1px,transparent 1.3px);background-size:auto,68px 68px;opacity:.35;pointer-events:none}\n.hsr-corner{position:absolute;width:16px;height:16px;border-color:var(--g);z-index:2}.hsr-c1{left:6px;top:6px;border-left:1px solid;border-top:1px solid}.hsr-c2{right:6px;top:6px;border-right:1px solid;border-top:1px solid}.hsr-c3{left:6px;bottom:6px;border-left:1px solid;border-bottom:1px solid}.hsr-c4{right:6px;bottom:6px;border-right:1px solid;border-bottom:1px solid}\n.hsr-bar{position:relative;display:grid;grid-template-columns:minmax(92px,.7fr) minmax(170px,1.6fr) minmax(110px,.8fr) minmax(82px,.65fr);align-items:stretch;border-bottom:1px solid rgba(199,173,112,.22)}\n.hsr-cell{min-width:0;max-width:100%;padding:10px 12px;border-left:1px solid rgba(199,173,112,.17);display:flex;flex-direction:column;justify-content:center;white-space:normal;overflow-wrap:anywhere;word-break:break-word}.hsr-cell:first-child{border-left:0}\n.hsr-label{font:700 8px/1.25 Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:#ad9869;white-space:normal;overflow-wrap:anywhere}.hsr-time{margin-top:4px;font:700 25px/1 Georgia,serif;color:#f0eadf}.hsr-value{margin-top:5px;font:600 12px/1.35 Arial,sans-serif;color:#e8e5de;white-space:normal;overflow-wrap:anywhere;word-break:break-word}.hsr-location{font:600 16px/1.25 Georgia,serif}.hsr-zone{margin-top:3px;font:600 9px/1.35 Arial,sans-serif;letter-spacing:.07em;color:#999;white-space:normal;overflow-wrap:anywhere;word-break:break-word}\n.hsr-rule{position:relative;height:1px;background:linear-gradient(90deg,transparent,var(--g),transparent);opacity:.6}.hsr-note{position:relative;display:grid;grid-template-columns:minmax(82px,.35fr) minmax(0,1.65fr);gap:12px;padding:10px 12px 11px}.hsr-kicker{font:700 8px/1.3 Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:#ad9869;white-space:normal;overflow-wrap:anywhere}.hsr-text{min-width:0;font:italic 13px/1.5 Georgia,'Times New Roman',serif;color:#ebe5da;white-space:normal;overflow-wrap:anywhere;word-break:break-word}\n@media(max-width:620px){.hsr-bar{grid-template-columns:1fr 1fr}.hsr-cell{border-left:0;border-top:1px solid rgba(199,173,112,.14);padding:10px}.hsr-cell:nth-child(1),.hsr-cell:nth-child(2){border-top:0}.hsr-cell:nth-child(even){border-left:1px solid rgba(199,173,112,.14)}.hsr-note{grid-template-columns:1fr;gap:5px}.hsr-time{font-size:22px}}\n</style>\n<section class=\"hsr-scene\"><span class=\"hsr-corner hsr-c1\"></span><span class=\"hsr-corner hsr-c2\"></span><span class=\"hsr-corner hsr-c3\"></span><span class=\"hsr-corner hsr-c4\"></span><div class=\"hsr-bar\"><div class=\"hsr-cell\"><div class=\"hsr-label\">Time · $2</div><div class=\"hsr-time\">$1</div></div><div class=\"hsr-cell\"><div class=\"hsr-label\">Location</div><div class=\"hsr-value hsr-location\">$5</div><div class=\"hsr-zone\">$6</div></div><div class=\"hsr-cell\"><div class=\"hsr-label\">Weather</div><div class=\"hsr-value\">$3</div></div><div class=\"hsr-cell\"><div class=\"hsr-label\">Temp</div><div class=\"hsr-value\">$4°C</div></div></div><div class=\"hsr-rule\"></div><div class=\"hsr-note\"><div class=\"hsr-kicker\">Scene Chronicle</div><div class=\"hsr-text\">$7</div></div></section>",
  "trimStrings": [],
  "placement": [1,2],
  "disabled": false,
  "markdownOnly": true,
  "promptOnly": false,
  "runOnEdit": true,
  "substituteRegex": 0,
  "minDepth": null,
  "maxDepth": 2
}