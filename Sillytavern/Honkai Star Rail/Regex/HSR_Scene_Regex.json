{
  "id": "ba706469-6c90-48fc-9ed4-5a54a617c4cf",
  "scriptName": "HSR Scene Tracker — Astral HUD",
  "findRegex": "/<hsr_scene>\\s*\\{\\s*\"schema\"\\s*:\\s*\"hsr_scene\\.v1\"\\s*,\\s*\"time\"\\s*:\\s*\"([^\"]*)\"\\s*,\\s*\"period\"\\s*:\\s*\"(dawn|day|dusk|night)\"\\s*,\\s*\"weather\"\\s*:\\s*\"([^\"]*)\"\\s*,\\s*\"temperature_c\"\\s*:\\s*(-?\\d+(?:\\.\\d+)?)\\s*,\\s*\"location\"\\s*:\\s*\"([^\"]*)\"\\s*,\\s*\"zone\"\\s*:\\s*\"([^\"]*)\"\\s*,\\s*\"situation\"\\s*:\\s*\"([^\"]*)\"\\s*\\}\\s*<\\/hsr_scene>/gi",
  "replaceString": "<link href=\"https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=Bai+Jamjuree:wght@400;500;600;700&family=Share+Tech+Mono&display=swap\" rel=\"stylesheet\"/><style>.hsr-scene{--gold:#e7c98b;--ice:#8dd8ff;position:relative;width:100%;max-width:900px;margin:0 auto 18px;overflow:hidden;color:#eef3ff;font-family:'Bai Jamjuree','Chakra Petch',sans-serif;background:radial-gradient(circle at 87% -20%,rgba(104,181,255,.25),transparent 42%),linear-gradient(135deg,rgba(17,25,43,.98),rgba(7,11,22,.98));border:1px solid rgba(231,201,139,.62);clip-path:polygon(14px 0,100% 0,100% calc(100% - 14px),calc(100% - 14px) 100%,0 100%,0 14px);box-shadow:0 12px 30px rgba(0,0,0,.32),inset 0 0 35px rgba(91,159,255,.06)}.hsr-scene:before{content:'';position:absolute;inset:0;pointer-events:none;opacity:.42;background-image:linear-gradient(rgba(139,199,255,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(139,199,255,.055) 1px,transparent 1px),radial-gradient(circle,rgba(255,255,255,.8) 0 1px,transparent 1.5px);background-size:24px 24px,24px 24px,79px 79px}.hsr-scene:after{content:'';position:absolute;top:0;left:34px;width:92px;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);box-shadow:0 0 12px var(--gold)}.hsr-scene-head{position:relative;display:grid;grid-template-columns:minmax(125px,.7fr) 1.8fr auto;align-items:stretch;border-bottom:1px solid rgba(231,201,139,.25)}.hsr-scene-clock{display:flex;align-items:center;gap:10px;padding:13px 16px;background:linear-gradient(100deg,rgba(231,201,139,.15),transparent);border-right:1px solid rgba(231,201,139,.22)}.hsr-orbit{position:relative;width:34px;height:34px;flex:0 0 34px;border:1px solid var(--gold);border-radius:50%;box-shadow:0 0 14px rgba(231,201,139,.25),inset 0 0 10px rgba(231,201,139,.12)}.hsr-orbit:before,.hsr-orbit:after{content:'';position:absolute;inset:7px;border:1px solid rgba(231,201,139,.65);transform:rotate(45deg)}.hsr-orbit:after{inset:14px;background:var(--gold);border:0;border-radius:50%;box-shadow:0 0 8px var(--gold)}.hsr-time{font:700 clamp(19px,3vw,28px)/1 'Share Tech Mono',monospace;letter-spacing:.05em;color:#fff;text-shadow:0 0 12px rgba(141,216,255,.38)}.hsr-period{margin-top:4px;font:600 8px/1 'Chakra Petch',sans-serif;letter-spacing:.22em;text-transform:uppercase;color:var(--gold)}.hsr-scene-place{min-width:0;padding:11px 16px}.hsr-scene-kicker{display:flex;align-items:center;gap:7px;margin-bottom:4px;font:600 8px/1 'Chakra Petch',sans-serif;letter-spacing:.24em;color:#8293b0;text-transform:uppercase}.hsr-scene-kicker:before{content:'◆';font-size:7px;color:var(--gold)}.hsr-location{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font:600 clamp(14px,2.2vw,19px)/1.2 'Chakra Petch','Bai Jamjuree',sans-serif;letter-spacing:.03em;color:#f4f0e6}.hsr-zone{margin-top:3px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:10px;color:#96a6c0}.hsr-climate{display:flex;align-items:center;gap:12px;padding:10px 16px;border-left:1px solid rgba(231,201,139,.2);background:linear-gradient(270deg,rgba(96,164,255,.1),transparent)}.hsr-weather-mark{position:relative;width:30px;height:30px;color:var(--ice)}.hsr-weather-mark svg{width:100%;height:100%;filter:drop-shadow(0 0 6px rgba(141,216,255,.5))}.hsr-weather{font-size:11px;font-weight:600;color:#dbe7f8;white-space:nowrap}.hsr-temp{margin-top:3px;font:700 17px/1 'Share Tech Mono',monospace;color:var(--gold);white-space:nowrap}.hsr-situation{position:relative;display:flex;align-items:flex-start;gap:10px;padding:10px 16px 11px;background:linear-gradient(90deg,rgba(231,201,139,.075),transparent 58%)}.hsr-situation-icon{display:grid;place-items:center;width:19px;height:19px;margin-top:1px;flex:0 0 19px;border:1px solid rgba(231,201,139,.55);transform:rotate(45deg);color:var(--gold)}.hsr-situation-icon span{transform:rotate(-45deg);font:700 11px/1 'Share Tech Mono'}.hsr-situation-copy{min-width:0}.hsr-situation-label{margin-bottom:3px;font:600 8px/1 'Chakra Petch';letter-spacing:.2em;text-transform:uppercase;color:#7e8da7}.hsr-situation-text{font-size:12px;line-height:1.45;color:#e4e9f2}.hsr-scene-period-dawn{--ice:#ffbfaf}.hsr-scene-period-day{--ice:#a9e5ff}.hsr-scene-period-dusk{--ice:#e8a7ff}.hsr-scene-period-night{--ice:#8da8ff}@media(max-width:620px){.hsr-scene-head{grid-template-columns:1fr auto}.hsr-scene-clock{border-right:0}.hsr-scene-place{grid-column:1/-1;grid-row:2;border-top:1px solid rgba(231,201,139,.16)}.hsr-climate{grid-column:2;grid-row:1}.hsr-location,.hsr-zone{white-space:normal}.hsr-weather{max-width:110px;overflow:hidden;text-overflow:ellipsis}.hsr-scene-clock,.hsr-scene-place,.hsr-climate,.hsr-situation{padding-left:12px;padding-right:12px}}</style><section class=\"hsr-scene hsr-scene-period-$2\"><div class=\"hsr-scene-head\"><div class=\"hsr-scene-clock\"><span class=\"hsr-orbit\"></span><div><div class=\"hsr-time\">$1</div><div class=\"hsr-period\">$2 · LOCAL TIME</div></div></div><div class=\"hsr-scene-place\"><div class=\"hsr-scene-kicker\">Current Location</div><div class=\"hsr-location\">$5</div><div class=\"hsr-zone\">$6</div></div><div class=\"hsr-climate\"><span class=\"hsr-weather-mark\"><svg viewBox=\"0 0 48 48\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M11 31h25a7 7 0 0 0 0-14 11 11 0 0 0-21-2 8 8 0 0 0-4 16Z\"/><path d=\"M17 36l-2 5m10-5-2 5m10-5-2 5\"/></svg></span><div><div class=\"hsr-weather\">$3</div><div class=\"hsr-temp\">$4°C</div></div></div></div><div class=\"hsr-situation\"><span class=\"hsr-situation-icon\"><span>!</span></span><div class=\"hsr-situation-copy\"><div class=\"hsr-situation-label\">Current Situation</div><div class=\"hsr-situation-text\">$7</div></div></div></section>",
  "trimStrings": [],
