ass=\"hi3v3-rail\"></span><div class=\"hi3v3-npc-symbol\"><span class=\"hi3v3-npc-symbol-mark\"><i></i></span></div><div class=\"hi3v3-npc-main\"><div class=\"hi3v3-npc-line\"><span class=\"hi3v3-micro\">Field Contact // Auxiliary Channel</span><span class=\"hi3v3-chip\">$2</span></div><div class=\"hi3v3-npc-name\">$1</div><div class=\"hi3v3-npc-role\">$3</div></div><div class=\"hi3v3-npc-side\"><span class=\"hi3v3-side-label\">Faction</span><strong>$4</strong><span class=\"hi3v3-dot\"></span><small>No portrait link</small></div></div></div>",
