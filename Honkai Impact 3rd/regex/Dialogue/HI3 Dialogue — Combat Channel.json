{
  "id": "fb9d72bb-b7ae-4d6a-89d8-133511e39fb7",
  "scriptName": "HI3 Dialogue — Voice Link V3",
  "findRegex": "/\\[HI3SAY\\|([^|\\]]+)\\|([^|\\]]+)\\|([\\s\\S]*?)\\]/g",
  "replaceString": "<link href=\"https://fonts.googleapis.com/css2?family=Oxanium:wght@400;500&family=Noto+Sans+Thai:wght@400;500&display=swap\" rel=\"stylesheet\"/><style>\n.hi3v3-ui{--a:#47c9df;--a2:#ed67b4;--gold:#dcae4d;--purple:#9275df;--green:#43bd96;--ink:#15364a;--soft:#52717d;--paper:rgba(248,253,254,.95);--paper2:rgba(221,241,245,.9);--line:rgba(48,117,139,.25);display:block;width:100%;max-width:860px;margin:10px auto 14px;color:var(--ink);font-family:'Oxanium','Noto Sans Thai',system-ui,sans-serif;font-size:14px;line-height:1.45;box-sizing:border-box}.hi3v3-ui *{box-sizing:border-box}.hi3v3-type-bio{--a:#dcae4d;--a2:#43bd96}.hi3v3-type-psy{--a:#ed67b4;--a2:#9275df}.hi3v3-type-mech{--a:#47c9df;--a2:#3d82e6}.hi3v3-type-qua{--a:#9275df;--a2:#ed67b4}.hi3v3-type-img{--a:#dcae4d;--a2:#47c9df}.hi3v3-type-sd{--a:#de6574;--a2:#dcae4d}.hi3v3-type-neutral{--a:#6baebe;--a2:#8ca4ae}.hi3v3-surface{position:relative;isolation:isolate;overflow:hidden;min-width:0;border:1px solid rgba(92,165,185,.54);background:linear-gradient(124deg,var(--paper),var(--paper2));box-shadow:0 10px 24px rgba(1,16,25,.18);clip-path:polygon(0 0,calc(100% - 17px) 0,100% 17px,100% 100%,17px 100%,0 calc(100% - 17px))}.hi3v3-surface:after{position:absolute;z-index:4;inset:0;background:linear-gradient(135deg,transparent 0 74%,rgba(72,201,223,.09) 74% 77%,transparent 77%);content:'';pointer-events:none}.hi3v3-surface.is-dark{color:#e4f5f7;border-color:rgba(88,207,226,.42);background:linear-gradient(115deg,rgba(7,25,38,.98),rgba(10,45,58,.96));box-shadow:0 12px 28px rgba(0,7,14,.32)}.hi3v3-rail{position:absolute;z-index:5;top:0;left:0;width:100%;height:3px;background:linear-gradient(90deg,var(--a) 0 42%,var(--a2) 42% 57%,rgba(255,255,255,.72) 57% 71%,transparent 90%);box-shadow:0 0 10px rgba(70,203,224,.32)}.hi3v3-micro{color:var(--soft);font-size:9px;letter-spacing:.13em;text-transform:uppercase}.is-dark .hi3v3-micro{color:#9bb8c1}.hi3v3-mark{display:grid;flex:0 0 auto;width:21px;height:21px;place-items:center;color:var(--a);border:1px solid currentColor;transform:rotate(45deg)}.hi3v3-mark i{width:5px;height:5px;background:currentColor;transform:rotate(-45deg)}.hi3v3-chip{display:inline-flex;align-items:center;justify-content:center;padding:3px 7px;color:var(--a);border:1px solid currentColor;font-size:8px;letter-spacing:.12em;line-height:1;text-transform:uppercase;white-space:nowrap}.hi3v3-dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--green);box-shadow:0 0 8px rgba(67,189,150,.7)}.hi3v3-signal{display:flex;gap:3px;align-items:end;height:14px}.hi3v3-signal i{display:block;width:3px;background:var(--a);transform:skew(-22deg)}.hi3v3-signal i:nth-child(1){height:6px;opacity:.45}.hi3v3-signal i:nth-child(2){height:10px;opacity:.72}.hi3v3-signal i:nth-child(3){height:14px}.hi3v3-signal i:nth-child(4){height:9px;opacity:.56}.hi3v3-name{overflow:hidden;color:var(--ink);font-size:25px;font-weight:500;letter-spacing:.02em;line-height:1.06;text-overflow:ellipsis;white-space:nowrap}.is-dark .hi3v3-name{color:#f4fbfc}.hi3v3-form{overflow:hidden;color:var(--soft);font-family:'Noto Sans Thai',system-ui,sans-serif;font-size:12px;text-overflow:ellipsis;white-space:nowrap}.is-dark .hi3v3-form{color:#b5d2d9}.hi3v3-side-label{color:var(--soft);font-size:8px;letter-spacing:.1em;text-transform:uppercase}.is-dark .hi3v3-side-label{color:#9bb8c1}@media(max-width:560px){.hi3v3-ui{margin:8px auto 11px}.hi3v3-surface{clip-path:polygon(0 0,calc(100% - 13px) 0,100% 13px,100% 100%,13px 100%,0 calc(100% - 13px))}.hi3v3-name{font-size:20px}.hi3v3-form{font-size:10px}.hi3v3-micro{font-size:8px}}\n\n.hi3v3-dialogue{padding:15px 18px 13px}.hi3v3-speech-head{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between}.hi3v3-speaker{display:flex;gap:11px;align-items:center;min-width:0}.hi3v3-speaker-copy{min-width:0}.hi3v3-speaker-name{overflow:hidden;margin-top:2px;color:var(--ink);font-size:16px;font-weight:500;letter-spacing:.03em;text-overflow:ellipsis;white-space:nowrap}.hi3v3-speech-copy{margin:12px 0 9px;padding-left:32px;color:var(--ink);font-family:'Noto Sans Thai',system-ui,sans-serif;font-size:14px;line-height:1.62;overflow-wrap:anywhere;white-space:pre-wrap}.hi3v3-speech-foot{display:flex;gap:8px;align-items:center;justify-content:space-between;padding-top:8px;border-top:1px solid var(--line);color:var(--soft);font-size:8px;letter-spacing:.1em;text-transform:uppercase}.hi3v3-monologue{padding:15px 18px 13px}.hi3v3-monologue .hi3v3-speaker-name{color:#f4fbfc}.hi3v3-monologue .hi3v3-monologue-copy-title{color:#d9edf0}.hi3v3-thought-copy{margin:13px 0 9px;padding:1px 0 1px 15px;color:#e4f5f7;border-left:2px solid var(--a2);font-family:'Noto Sans Thai',system-ui,sans-serif;font-size:14px;font-style:italic;line-height:1.7;overflow-wrap:anywhere;white-space:pre-wrap}.hi3v3-thought-foot{padding-top:8px;border-top:1px solid rgba(198,239,243,.18);color:#9bb8c1;font-size:8px;letter-spacing:.1em;text-transform:uppercase}@media(max-width:560px){.hi3v3-dialogue,.hi3v3-monologue{padding:12px 13px 11px}.hi3v3-speaker{gap:9px}.hi3v3-speaker-name{font-size:14px}.hi3v3-speech-copy,.hi3v3-thought-copy{margin-top:10px;padding-left:25px;font-size:13px}.hi3v3-thought-copy{padding-left:11px}.hi3v3-speech-foot,.hi3v3-thought-foot{font-size:7px}}\n</style><div class=\"hi3v3-ui hi3v3-type-$2\"><div class=\"hi3v3-surface hi3v3-dialogue\"><span class=\"hi3v3-rail\"></span><div class=\"hi3v3-speech-head\"><div class=\"hi3v3-speaker\"><span class=\"hi3v3-mark\"><i></i></span><div class=\"hi3v3-speaker-copy\"><div class=\"hi3v3-micro\">Voice Link // Transmission</div><div class=\"hi3v3-speaker-name\">$1</div></div></div><span class=\"hi3v3-chip\">$2</span></div><div class=\"hi3v3-speech-copy\">$3</div><div class=\"hi3v3-speech-foot\"><span>Hyperion Relay</span><span><span class=\"hi3v3-dot\"></span> Live Channel</span></div></div></div>",
